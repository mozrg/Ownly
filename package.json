{
  "name": "ownly",
  "private": true,
  "version": "1.0.0",
  "description": "Ownly — a desktop player for music you already have access to",
  "author": "Ownly",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "prepare:ytdlp": "node scripts/download-ytdlp.mjs --platform=win32 --arch=x64",
    "prepare:ytdlp:current": "node scripts/download-ytdlp.mjs",
    "build:renderer": "tsc -b && vite build",
    "dist:win": "npm run prepare:ytdlp && npm run build:renderer && electron-builder --win nsis portable",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "shoot": "node scripts/shoot.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "e2e": "npm run build && node scripts/e2e-youtube.mjs",
    "audit:search": "npm run build && node scripts/audit-search.mjs",
    "audit:playback": "npm run build && node scripts/audit-playback.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "45.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
