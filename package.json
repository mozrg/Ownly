{
  "name": "ownly",
  "private": true,
  "version": "1.0.0",
  "description": "Ownly — a desktop music player that plays any song on the internet",
  "author": "Ownly",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "desktop": "npm run build && electron .",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "shoot": "node scripts/shoot.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "e2e": "npm run build && node scripts/e2e-youtube.mjs",
    "audit:search": "npm run build && node scripts/audit-search.mjs",
    "audit:playback": "npm run build && node scripts/audit-playback.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
